# Copy to .env for local development. `shopify app dev` fills SHOPIFY_* automatically.

# Postgres 16 with pgvector (docker compose up -d gives you this locally)
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant

# Set by the Shopify CLI in development; set by hand in production
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,read_inventory,read_orders,read_customers,read_locales,read_markets,read_content,read_customer_events,write_pixels

# Used by `npm run db:seed`
SHOP=the-spirits-embassy.myshopify.com

# Only for `npm run test:db` (a separate, throwaway database: tests TRUNCATE tables)
TEST_DATABASE_URL=
